{
  "version": 2,
  "key": "github",
  "provider": "github",
  "mode": "scheduled",
  "reader": "source-reader",
  "publishAttention": true,
  "initialLimit": 20,
  "windowDays": 0,
  "tasks": [
    {
      "key": "sync",
      "handler": "source.read",
      "pool": "source-io",
      "trigger": "interval",
      "intervalMinutes": 15,
      "batchSize": 20,
      "timeoutSeconds": 120
    }
  ]
}

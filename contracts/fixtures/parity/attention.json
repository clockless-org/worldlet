 {
  "name": "quote whitespace is canonicalized",
  "operation": "canonicalSourceQuotes",
  "input": {
   "items": [
    {
     "title": "t",
     "sources": [
      {
       "provider": "gmail",
       "id": "m1",
       "quote": "send  the\ndeck"
      },
      {
       "provider": "gmail",
       "id": "m2",
       "quote": "missing"
      }
     ]
    }
   ],
   "evidence": {
    "gmail:m1": {
     "text": "Could you send the  deck today?"
    },
    "gmail:m2": {
     "text": "nothing here"
    }
   }
  },
  "expected": {
   "ok": true,
   "value": [
    {
     "sources": [
      {
       "id": "m1",
       "provider": "gmail",
       "quote": "send the  deck"
      },
      {
       "id": "m2",
       "provider": "gmail",
       "quote": "missing"
      }
     ],
     "title": "t"
    }
   ]
  }
 },
 {
  "name": "ambiguous quote is unchanged",

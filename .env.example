# For local wrangler development, copy to .dev.vars and use fresh random test values.
# Production values are Cloudflare Secrets. Never commit .dev.vars or real keys.
ALADDIN_VOICE_TOKEN=replace-with-local-trial-code
ALADDIN_SESSION_SECRET=replace-with-long-random-session-secret
ALADDIN_DATA_SECRET=replace-with-long-random-data-secret
# Optional OAuth applications (same callback /api/connectors/callback):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

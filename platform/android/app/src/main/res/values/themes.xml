<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The world is dark behind everything, so the window starts on the world's dark green. -->
    <style name="Theme.Worldlet" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/world</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="world">#1E2A22</color>
</resources>
